# Expo — copy to .env in project root (not backend/)
# Points to whoever is running "npm run dev" in backend/, NOT Render Postgres.
#
# Physical phone (same Wi-Fi as dev PC):
# EXPO_PUBLIC_API_URL=http://192.168.1.36:4000
#
# Android emulator:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
#
# Temporary remote testing (ngrok — URL changes each restart on free tier):
# EXPO_PUBLIC_API_URL=https://abc123.ngrok-free.app
#
# Later: API deployed on Render:
# EXPO_PUBLIC_API_URL=https://smitten-api.onrender.com
EXPO_PUBLIC_API_URL=http://localhost:4000

# Required for push notifications on release APK (from `eas project:info` or expo.dev):
# Required for push when app is closed (from `npx eas-cli init` → projectId):
# EXPO_PUBLIC_EAS_PROJECT_ID=b27f3579-9df4-4c3f-adcc-f11fcb18b96a

# Optional — Giphy API key for huge GIF search (free, ~5 min signup: https://developers.giphy.com/dashboard/)
# EXPO_PUBLIC_GIPHY_API_KEY=your_giphy_api_key

# Tenor is deprecated for new Google Cloud projects — skip unless you already have a key
# EXPO_PUBLIC_TENOR_API_KEY=your_tenor_api_key

# Set to true to disable screenshot blocking in development
EXPO_PUBLIC_DISABLE_SCREENSHOT_BLOCK=false
